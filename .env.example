# Cadena de conexión PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relevamiento?schema=public"

# Secreto para firmar la cookie de sesión (mínimo 32 caracteres aleatorios)
AUTH_SECRET="cambie-este-valor-por-uno-aleatorio-de-32-caracteres-o-mas"

# Usuario administrador inicial creado por `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CambiarEstaClave123!"
ADMIN_NAME="Consultor BI"

# Carpeta donde se guardan los archivos adjuntos (evidencias, esquemas, documentación)
UPLOAD_DIR="./storage/uploads"

# Tamaño máximo por archivo en MB
MAX_UPLOAD_MB="25"
